# Use the same database, broker, OAuth credentials and Stellar network as lumenrise-api.
NODE_ENV=development
LOG_LEVEL=info
DB_URI=mongodb://127.0.0.1:27017?replicaSet=rs0&directConnection=true
DB_NAME=lumenrise
RABBITMQ_URL=amqp://127.0.0.1:5672
RABBITMQ_PASSWORD=password
SYNC_WORKER_POLL_INTERVAL_MS=2000
HEALTH_PORT=5001

GITHUB_CLIENT_ID=private
GITHUB_CLIENT_SECRET=private

X_CLIENT_ID=private
X_CLIENT_SECRET=private
X_AUTO_SYNC_INTERVAL_HOURS=0

STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
LAUNCH_TESTNET_FACTORY_CONTRACT_ID=C....

STELLAR_PUBLIC_RPC_URL=
STELLAR_PUBLIC_HORIZON_URL=https://horizon.stellar.org
LAUNCH_PUBLIC_FACTORY_CONTRACT_ID=C....

CREDENTIAL_ENCRYPTION_KEY=private
